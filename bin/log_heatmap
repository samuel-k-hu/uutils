#! perl

use v5.36;

use utf8;
use open qw(:std :encoding(UTF-8));

use JSON::PP;
use Time::Piece;
use Time::Seconds;

if ($^O eq 'MSWin32') {
	require Win32;
	Win32::SetConsoleOutputCP(65001);
}

my $json = JSON::PP->new->pretty;
open my $fh, '<:encoding(UTF-8)', $ARGV[0];
my $raw = do { local $/; <$fh> };
close $fh;
my $data = $raw ? $json->decode($raw) : {};

my $year = localtime->year;
my $mon;
my $t = Time::Piece->strptime("$year-01-01", "%Y-%m-%d");

my $now = localtime;

while ($t->year == $year) {
	last if $t->epoch > $now->epoch;
	last if $t->year != $year;
	if (!defined($mon) or $t->strftime("%m") != $mon) {
		print "\n" if defined($mon);
		$mon = $t->strftime("%m");
		print "$mon ";
	}
	my $date = $t->strftime("%Y-%m-%d");
	my $value = 0;
	if (defined($data->{$date})) {
		my %record = %{$data->{$date}};
		foreach my $k (keys %record) {
			$value += $record{$k};
		}
	}
	if ($value == 0) {
		print '_';
	}
	elsif ($value == 5) {
		print 'x';
	}
	else {
		print '.';
	}
	$t += ONE_DAY;
}
