#! perl

use v5.36;

use utf8;
use open qw(:std :encoding(UTF-8));

use JSON::PP;
use Time::Piece;
use Time::Seconds;

if ($^O eq 'MSWin32') {
	require Win32;
	Win32::SetConsoleOutputCP(65001);
}

my $json = JSON::PP->new->pretty;
open my $fh, '<:encoding(UTF-8)', $ARGV[0];
my $raw = do { local $/; <$fh> };
close $fh;
my $data = $raw ? $json->decode($raw) : {};

my $year = localtime->year;
my $t = Time::Piece->strptime("$year-01-01", "%Y-%m-%d");
my $mon = $t->strftime("%m");

my @marks = qw(_ . | / x *);
my @gray = (255, 251, 247, 243, 239, 235);

print "$mon\t";
while ($t->year == $year) {
	my $date = $t->strftime("%Y-%m-%d");
	my $value = 0;
	if (defined($data->{$date})) {
		my %record = %{$data->{$date}};
		foreach my $k (keys %record) {
			$value += $record{$k};
		}
	}
	my $g = $gray[$value];
	if ($value == 0) {
		print '_';
	}
	elsif ($value == 5) {
		print 'x';
	}
	else {
		print '.';
	}
	$t += ONE_DAY;
	if ($t->strftime("%m") != $mon and $t->year == $year) {
		$mon = $t->strftime("%m");
		print "\n$mon\t";
	}
}
